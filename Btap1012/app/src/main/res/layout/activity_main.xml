<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvThongTinSinhVien"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SV: PHAM TRAN THANH VINH - MSV: 2415053122248 - Lớp: 24T2"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etTenCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tên công việc" />

    <EditText
        android:id="@+id/etMoTa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập mô tả công việc" />

    <Button
        android:id="@+id/btnTaoCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tạo công việc" />

    <Button
        android:id="@+id/btnXemDanhSach"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xem danh sách công việc" />
</LinearLayout>